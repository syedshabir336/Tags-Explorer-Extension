<Window x:Class="TagExplorer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:TagExplorer" Title="Tag Explorer" Height="800" Width="1200" MinHeight="600" MinWidth="900" Background="#F3F5F9">
  <Window.Resources><local:ThumbnailConverter x:Key="ThumbnailConverter"/></Window.Resources>
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#172033" Padding="18"><DockPanel>
      <StackPanel><TextBlock Text="TAG EXPLORER" Foreground="White" FontSize="22" FontWeight="Bold"/><TextBlock Text="Browse, view and organize your photos" Foreground="#B8C4D8"/></StackPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="Add images" Click="AddFiles_Click" Padding="12,7" Margin="4"/><Button Content="Add folder" Click="AddFolder_Click" Padding="12,7" Margin="4"/><Button Content="Explorer menu" Click="InstallShell_Click" Padding="12,7" Margin="4"/></StackPanel>
    </DockPanel></Border>
    <Grid Margin="16"><Grid.ColumnDefinitions><ColumnDefinition Width="210"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Background="White" CornerRadius="10" Padding="12" Margin="0,0,12,0"><DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="YOUR TAGS" FontWeight="Bold" Margin="4,5,4,12"/>
        <Button DockPanel.Dock="Bottom" Content="Create tag" Click="CreateTag_Click" Padding="8" Margin="0,8,0,0"/>
        <ListBox x:Name="TagList" BorderThickness="0" DisplayMemberPath="Name" SelectionChanged="TagList_SelectionChanged"/>
      </DockPanel></Border>
      <DockPanel Grid.Column="1">
        <Border DockPanel.Dock="Top" Background="White" CornerRadius="8" Padding="6" Margin="0,0,0,10"><DockPanel>
          <TextBox x:Name="SearchBox" ToolTip="Search filenames and tags" FontSize="15" Padding="8" BorderThickness="0" TextChanged="SearchBox_TextChanged"/>
          <Button Content="Clear" Click="Clear_Click" Padding="8,4"/>
        </DockPanel></Border>
        <Border DockPanel.Dock="Bottom" Background="White" CornerRadius="8" Padding="8" Margin="0,10,0,0"><DockPanel>
          <TextBlock x:Name="StatusText" VerticalAlignment="Center"/>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="View photo" Click="ViewPhoto_Click" Padding="10,6" Margin="4"/><Button Content="Apply tags to selected" Click="ApplyTags_Click" Padding="10,6" Margin="4"/><Button Content="Refresh" Click="Refresh_Click" Padding="10,6" Margin="4"/></StackPanel>
        </DockPanel></Border>
        <ListBox x:Name="PhotoList" Background="Transparent" BorderThickness="0" SelectionMode="Extended" MouseDoubleClick="PhotoList_MouseDoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.ItemTemplate><DataTemplate><Border Width="205" Height="225" Background="White" CornerRadius="9" Margin="5" Padding="8"><DockPanel>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="2,6,2,2"/>
            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Tags}" Foreground="#667085" FontSize="10" TextWrapping="Wrap" MaxHeight="30"/>
            <Border Background="#E9EDF3" CornerRadius="5" ClipToBounds="True"><Image Source="{Binding Path, Converter={StaticResource ThumbnailConverter}}" Height="165" Stretch="Uniform"/></Border>
          </DockPanel></Border></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>