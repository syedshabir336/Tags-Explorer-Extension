<Window x:Class="TagExplorer.PhotoViewerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Photo viewer" WindowState="Maximized" Background="#101318" KeyDown="Window_KeyDown">
  <DockPanel>
    <Border DockPanel.Dock="Top" Background="#202631" Padding="12"><DockPanel>
      <TextBlock x:Name="PhotoTitle" Foreground="White" VerticalAlignment="Center" FontSize="14" TextTrimming="CharacterEllipsis"/>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"><Button Content="⟲ Rotate left" Click="RotateLeft_Click" Padding="12,7" Margin="4"/><Button Content="⟳ Rotate right" Click="RotateRight_Click" Padding="12,7" Margin="4"/><Button Content="Previous" Click="Previous_Click" Padding="12,7" Margin="4"/><Button Content="Next" Click="Next_Click" Padding="12,7" Margin="4"/><Button Content="Close" Click="Close_Click" Padding="12,7" Margin="4"/></StackPanel>
    </DockPanel></Border>
    <Border Background="#101318" Padding="12"><Image x:Name="FullImage" Stretch="Uniform" RenderTransformOrigin="0.5,0.5"><Image.RenderTransform><RotateTransform x:Name="ImageRotation" Angle="0"/></Image.RenderTransform></Image></Border>
    <TextBlock x:Name="PhotoCounter" DockPanel.Dock="Bottom" Foreground="#B8C4D8" Background="#202631" Padding="10" HorizontalAlignment="Center"/>
  </DockPanel>
</Window>